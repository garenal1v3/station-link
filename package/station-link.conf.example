# Настройки station-link. Рабочая копия — /data/opt/station-link/station-link.conf
# (создаётся из этого шаблона при первом запуске и переживает переустановку пакета).
# Формат — строки KEY=value, без кавычек; файл не исполняется, только читается.

# Адрес своего прокси-сервера: ws://<сервер>:8443/uni.ws (или wss://...).
# Пусто — apply откажется работать.
SERVER_URL=

# Проверять ли перед apply, что сервер отвечает на http://<сервер>:<порт>/healthz
# (только для ws://). 1 — да, 0 — нет.
HEALTH_CHECK=1
